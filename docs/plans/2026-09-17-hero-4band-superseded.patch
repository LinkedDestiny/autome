+/**
+ * Branch, worktree and creation time, as labelled facts rather than chips.
+ *
+ * They were three chips in the status row, and the worktree one carried the
+ * absolute path — `/Users/…/voice-schedule/.worktree/<slug>` — which was by
+ * some margin the widest thing on the screen. The path is shown relative to
+ * the repository, the way the design mock always had it; the absolute form
+ * stays on hover, where it is available without costing a line.
+ */
+function heroFacts(task, data) {
+  const facts = h('dl.hero__facts');
+  const add = (label, value, full) => {
+    if (!value) return;
+    facts.appendChild(
+      h('div.hero__fact', [h('dt', { text: label }), h('dd', { text: value, title: full || value })])
+    );
+  };
+
+  add('分支', task.branch);
+
+  const worktree = (data && data.worktree) || '';
+  const cut = worktree.indexOf('/.worktree/');
+  add('工作树', cut >= 0 ? worktree.slice(cut + 1) : worktree, worktree);
+
+  if (task.created_at) {
+    add('创建', `${labels.clock(task.created_at)} · 已存在 ${labels.duration(task.created_at)}`);
+  }
+  return facts;
+}
