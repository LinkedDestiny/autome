+/* The task hero, in four bands. `min-width: 0` on the head is what lets a long
+   title shrink instead of shoving the buttons off the card. */
+.hero__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
+.hero__head { min-width: 0; display: flex; flex-direction: column; gap: 10px; }
+.hero__title { overflow-wrap: anywhere; }
+.hero__status { display: flex; gap: 6px; flex-wrap: wrap; }
+.hero__facts { display: flex; flex-wrap: wrap; gap: 12px 34px; margin: 16px 0 2px; }
+.hero__fact { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
