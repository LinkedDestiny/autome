{
  "name": "autome-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "Autome desktop shell: bundled Web panel with native directory picker and notifications.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "package": "../../scripts/package.sh",
    "stage-web": "node scripts/stage-web.js",
    "smoke": "node --test smoke/shell-smoke.test.js"
  },
  "devDependencies": {
    "electron": "43.2.0"
  },
  "build": {
    "appId": "dev.autome.desktop",
    "productName": "Autome",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "core",
        "to": "core"
      },
      {
        "from": "web",
        "to": "web"
      },
      {
        "from": "web/node_modules",
        "to": "web/node_modules"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": false,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  }
}
